# Security/runtime
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Database
POSTGRES_DB=cineprime
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis/Celery
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/1
CACHE_KEY_PREFIX=cineprime_api

# Throttling
THROTTLE_ANON_RATE=60/minute
THROTTLE_USER_RATE=120/minute
THROTTLE_LOGIN_RATE=5/minute
THROTTLE_RESERVATION_RATE=10/minute
# Rate limit on POST /api/v1/auth/password-reset/, keyed by IP+email, to prevent email-bombing an address.
THROTTLE_PASSWORD_RESET_RATE=3/hour
# Rate limit on the same endpoint, keyed by email alone (independent of IP), to cap total
# requests against a single address even if the attacker rotates IPs.
THROTTLE_PASSWORD_RESET_EMAIL_RATE=3/hour
# Rate limit on POST /api/v1/auth/verify-email/resend/, keyed by authenticated user.
THROTTLE_EMAIL_VERIFICATION_RESEND_RATE=3/hour

# Logging
LOG_LEVEL=INFO

# Email
# IMPORTANT: in production (DJANGO_ENV=production), EMAIL_BACKEND must be the SMTP backend and
# EMAIL_HOST must point to a real provider (e.g. SendGrid, SES, Postmark) — the app refuses to
# start otherwise. EMAIL_HOST_USER/EMAIL_HOST_PASSWORD must hold real credentials for that
# provider and are also required (non-empty) in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@cineprime.local
TICKET_CONFIRMATION_EMAIL_SENT_TTL_SECONDS=604800
# How long an email verification link stays valid, in seconds (default: 3 days).
EMAIL_VERIFICATION_TOKEN_MAX_AGE_SECONDS=259200

# Frontend integration
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Base URL of the deployed frontend, used to build links in verification/password-reset emails.
# IMPORTANT: in production (DJANGO_ENV=production), this must be set to an https URL that is
# not localhost/loopback — the app refuses to start otherwise.
FRONTEND_BASE_URL=http://localhost:3000
